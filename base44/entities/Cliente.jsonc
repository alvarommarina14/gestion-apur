{
  "name": "Cliente",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre completo del cliente"
    },
    "telefono": {
      "type": "string",
      "description": "N\u00famero de tel\u00e9fono"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email del cliente (opcional)"
    },
    "precio": {
      "type": "number",
      "description": "Precio que debe pagar mensualmente (abono o clase)"
    },
    "clasificacion": {
      "type": "string",
      "enum": [
        "ocasional",
        "recurrente"
      ],
      "default": "ocasional",
      "description": "Clasificaci\u00f3n del cliente"
    },
    "tipo_cliente": {
      "type": "string",
      "enum": [
        "clase",
        "abono"
      ],
      "default": "clase",
      "description": "Tipo de cliente: clase individual o abono mensual"
    },
    "es_alumno": {
      "type": "boolean",
      "default": false,
      "description": "Si el cliente es alumno con profesor asignado"
    },
    "profesor_id": {
      "type": "string",
      "description": "ID del profesor designado (si es alumno)"
    },
    "profesor_nombre": {
      "type": "string",
      "description": "Nombre del profesor designado (si es alumno)"
    },
    "notas": {
      "type": "string",
      "description": "Notas y observaciones sobre el cliente"
    },
    "fecha_primer_turno": {
      "type": "string",
      "format": "date",
      "description": "Fecha del primer turno"
    },
    "total_turnos": {
      "type": "number",
      "default": 0,
      "description": "Cantidad total de turnos realizados"
    },
    "total_gastado": {
      "type": "number",
      "default": 0,
      "description": "Total gastado hist\u00f3rico"
    },
    "ultimo_turno_fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha del \u00faltimo turno"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "Si el cliente est\u00e1 activo"
    }
  },
  "required": [
    "nombre",
    "telefono"
  ]
}