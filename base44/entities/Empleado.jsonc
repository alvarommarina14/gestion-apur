{
  "name": "Empleado",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "description": "Nombre completo del empleado"
    },
    "email_gmail": {
      "type": "string",
      "format": "email",
      "description": "Email de Gmail para Google Calendar (OBLIGATORIO)"
    },
    "tel": {
      "type": "string",
      "description": "Tel\u00e9fono en formato internacional (+549341XXXXXXXX)"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "Si el empleado est\u00e1 activo para recibir notificaciones"
    },
    "rol": {
      "type": "string",
      "enum": [
        "admin",
        "empleado"
      ],
      "default": "empleado",
      "description": "Rol del empleado en el sistema"
    }
  },
  "required": [
    "nombre",
    "email_gmail",
    "tel"
  ]
}